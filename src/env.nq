pub fn program_argument() -> option<str>
audit {
    intent("Return the operating-system argument at index zero when present.");
    mutates();
    effects(io);
}
{
    return arg_get(0);
}

pub fn argument_count() -> i32
audit {
    intent("Count user arguments without including the program argument.");
    mutates();
    effects(io);
}
{
    let raw_count = arg_count();
    if raw_count <= 1 {
        return 0;
    }
    return raw_count - 1;
}

pub fn argument_at(index: i32) -> option<str>
audit {
    intent("Return a zero-based user argument without exposing the program argument.");
    mutates();
    effects(io);
}
{
    if index < 0 or index >= argument_count() {
        return None;
    }
    return arg_get(index + 1);
}

pub fn arguments() -> list<str>
audit {
    intent("Collect user arguments into an owned list without the program argument.");
    mutates();
    effects(io);
}
{
    let mut values: list<str> = list();
    let count = argument_count();
    let mut index = 0;
    while index < count {
        let current = argument_at(index);
        match current {
            Some(value) => {
                list_push(mutref values, value);
            },
            None => {
            },
        }
        index = index + 1;
    }
    return values;
}

pub fn environment_get(name: str) -> result<option<str>, io_err>
audit {
    intent("Read an environment value without validating its bytes as UTF-8.");
    mutates();
    effects(io);
}
{
    return env_get(name);
}

pub fn working_directory() -> result<str, io_err>
audit {
    intent("Return the absolute current working directory reported by Linux.");
    mutates();
    effects(io);
}
{
    return current_dir();
}
