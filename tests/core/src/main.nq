use std::env as env;
use std::num as num;
use std::path as path;
use std::stdio as stdio;
use std::text as text;
use std::utf8 as utf8;

fn list_item_equals(items: ref list<str>, index: i32, expected: str) -> bool {
    let item = list_get(ref items, index);
    match item {
        Some(value) => {
            return value == expected;
        },
        None => {
            return false;
        },
    }
}

fn text_tests() -> i32 {
    if text::byte_len("aé") != 3 {
        return 1;
    }
    let second_byte = text::byte_at("aé", 1);
    match second_byte {
        Some(value) => {
            if value != 195 {
                return 2;
            }
        },
        None => {
            return 3;
        },
    }
    match text::byte_slice("abcdef", 1, 4) {
        Some(value) => {
            if value != "bcd" {
                return 4;
            }
        },
        None => {
            return 5;
        },
    }
    if not text::starts_with("nauqtype", "nauq") {
        return 6;
    }
    if not text::ends_with("nauqtype", "type") {
        return 7;
    }
    if not text::contains("nauqtype", "qt") {
        return 8;
    }
    match text::find_from("banana", "ana", 2) {
        Some(index) => {
            if index != 3 {
                return 9;
            }
        },
        None => {
            return 10;
        },
    }
    match text::rfind("banana", "ana") {
        Some(index) => {
            if index != 3 {
                return 11;
            }
        },
        None => {
            return 12;
        },
    }
    match text::strip_prefix("nauqtype", "nauq") {
        Some(value) => {
            if value != "type" {
                return 13;
            }
        },
        None => {
            return 14;
        },
    }
    match text::strip_suffix("nauqtype", "type") {
        Some(value) => {
            if value != "nauq" {
                return 15;
            }
        },
        None => {
            return 16;
        },
    }
    if text::trim_ascii(" \t\nvalue ") != "value" {
        return 17;
    }

    let parts = text::split_literal("a,,b,", ",");
    if list_len(ref parts) != 4 {
        return 18;
    }
    if not list_item_equals(ref parts, 0, "a") {
        return 19;
    }
    if not list_item_equals(ref parts, 1, "") {
        return 20;
    }
    if not list_item_equals(ref parts, 2, "b") {
        return 21;
    }
    if not list_item_equals(ref parts, 3, "") {
        return 22;
    }
    if text::join(ref parts, "|") != "a||b|" {
        return 23;
    }
    if text::replace_all("one fish two fish", "fish", "cat") != "one cat two cat" {
        return 24;
    }
    if text::replace_all("unchanged", "", "x") != "unchanged" {
        return 25;
    }
    return 0;
}

fn utf8_tests() -> i32 {
    let valid = "A¢€😀";
    if str_len(valid) != 10 {
        return 1;
    }
    if not utf8::is_valid(valid) {
        return 2;
    }
    match utf8::validate(valid) {
        Ok(_) => {
        },
        Err(_) => {
            return 3;
        },
    }
    match utf8::code_point_count(valid) {
        Ok(count) => {
            if count != 4 {
                return 4;
            }
        },
        Err(_) => {
            return 5;
        },
    }
    match utf8::code_point_at(valid, 3) {
        Ok(code_point) => {
            if code_point != 128512 {
                return 6;
            }
        },
        Err(_) => {
            return 7;
        },
    }
    match utf8::slice_code_points(valid, 1, 3) {
        Ok(value) => {
            if value != "¢€" {
                return 8;
            }
        },
        Err(_) => {
            return 9;
        },
    }

    let truncated_slice = str_slice("€", 0, 2);
    match truncated_slice {
        Some(truncated) => {
            match utf8::decode_at(truncated, 0) {
                Err(utf8::Utf8UnexpectedEnd(index)) => {
                    if index != 0 {
                        return 10;
                    }
                },
                _ => {
                    return 12;
                },
            }
        },
        None => {
            return 13;
        },
    }

    let continuation_slice = str_slice("€", 1, 2);
    match continuation_slice {
        Some(continuation) => {
            match utf8::decode_at(continuation, 0) {
                Err(utf8::Utf8UnexpectedContinuation(index)) => {
                    if index != 0 {
                        return 14;
                    }
                },
                _ => {
                    return 16;
                },
            }
        },
        None => {
            return 17;
        },
    }

    let three_byte_lead = str_slice("€", 0, 1);
    match three_byte_lead {
        Some(lead) => {
            let invalid_continuation = str_concat(lead, "AB");
            match utf8::decode_at(invalid_continuation, 0) {
                Err(utf8::Utf8InvalidContinuation(index)) => {
                    if index != 1 {
                        return 18;
                    }
                },
                _ => {
                    return 20;
                },
            }
        },
        None => {
            return 21;
        },
    }

    let e0_lead = str_slice("ࠀ", 0, 1);
    let euro_tail = str_slice("€", 1, 3);
    match e0_lead {
        Some(lead) => {
            match euro_tail {
                Some(tail) => {
                    let overlong = str_concat(lead, tail);
                    match utf8::decode_at(overlong, 0) {
                        Err(utf8::Utf8OverlongEncoding(index)) => {
                            if index != 0 {
                                return 22;
                            }
                        },
                        _ => {
                            return 24;
                        },
                    }
                },
                None => {
                    return 25;
                },
            }
        },
        None => {
            return 26;
        },
    }

    let ed_lead = str_slice("퀀", 0, 1);
    let surrogate_tail = str_slice("ࠀ", 1, 3);
    match ed_lead {
        Some(lead) => {
            match surrogate_tail {
                Some(tail) => {
                    let surrogate = str_concat(lead, tail);
                    match utf8::decode_at(surrogate, 0) {
                        Err(utf8::Utf8SurrogateCodePoint(index)) => {
                            if index != 0 {
                                return 27;
                            }
                        },
                        _ => {
                            return 29;
                        },
                    }
                },
                None => {
                    return 30;
                },
            }
        },
        None => {
            return 31;
        },
    }

    match utf8::decode_at(valid, 10) {
        Err(error) => {
            if utf8::utf8_error_index(error) != 10 {
                return 32;
            }
        },
        Ok(_) => {
            return 33;
        },
    }
    match utf8::code_point_at(valid, 4) {
        Err(utf8::Utf8CodePointIndexOutOfBounds(index)) => {
            if index != 4 {
                return 34;
            }
        },
        _ => {
            return 36;
        },
    }
    return 0;
}

fn path_tests() -> i32 {
    if not path::path_is_absolute("/usr/bin") {
        return 1;
    }
    if path::path_is_absolute("usr/bin") {
        return 2;
    }
    if not path::path_is_root("///") {
        return 3;
    }
    if path::path_is_root("/usr") {
        return 4;
    }
    if not path::path_has_trailing_separator("a/") {
        return 5;
    }

    match path::path_file_name("/srv/data/report.txt/") {
        Some(value) => {
            if value != "report.txt" {
                return 6;
            }
        },
        None => {
            return 7;
        },
    }
    match path::path_file_name("/") {
        Some(_) => {
            return 8;
        },
        None => {
        },
    }
    match path::path_parent("/srv//data/report.txt/") {
        Some(value) => {
            if value != "/srv//data" {
                return 9;
            }
        },
        None => {
            return 10;
        },
    }
    match path::path_parent("report.txt") {
        Some(value) => {
            if value != "." {
                return 11;
            }
        },
        None => {
            return 12;
        },
    }
    match path::path_parent("/") {
        Some(_) => {
            return 13;
        },
        None => {
        },
    }

    match path::path_extension("archive.tar.gz") {
        Some(value) => {
            if value != "gz" {
                return 14;
            }
        },
        None => {
            return 15;
        },
    }
    match path::path_extension(".profile") {
        Some(_) => {
            return 16;
        },
        None => {
        },
    }
    match path::path_extension("..") {
        Some(_) => {
            return 38;
        },
        None => {
        },
    }
    match path::path_extension("name.") {
        Some(value) => {
            if value != "" {
                return 17;
            }
        },
        None => {
            return 18;
        },
    }
    match path::path_stem("archive.tar.gz") {
        Some(value) => {
            if value != "archive.tar" {
                return 19;
            }
        },
        None => {
            return 20;
        },
    }
    match path::path_stem(".profile") {
        Some(value) => {
            if value != ".profile" {
                return 21;
            }
        },
        None => {
            return 22;
        },
    }
    match path::path_stem("..") {
        Some(value) => {
            if value != ".." {
                return 39;
            }
        },
        None => {
            return 40;
        },
    }

    if path::path_join("/srv/data/", "report.txt") != "/srv/data/report.txt" {
        return 23;
    }
    if path::path_join("/srv/data", "/tmp/report.txt") != "/tmp/report.txt" {
        return 24;
    }
    if path::path_normalize("") != "." {
        return 25;
    }
    if path::path_normalize("a//b/./c/..") != "a/b" {
        return 26;
    }
    if path::path_normalize("/../../a//b/") != "/a/b" {
        return 27;
    }
    if path::path_normalize("../../a/../b") != "../../b" {
        return 28;
    }
    if path::path_normalize("a/..") != "." {
        return 29;
    }
    if path::path_normalize_join("/srv/./data", "../logs") != "/srv/logs" {
        return 30;
    }
    if not path::path_is_normalized("../../b") {
        return 31;
    }
    if path::path_is_normalized("a//b") {
        return 32;
    }

    let components = path::path_components("/a//./b/../");
    if list_len(ref components) != 4 {
        return 33;
    }
    if not list_item_equals(ref components, 0, "a") {
        return 34;
    }
    if not list_item_equals(ref components, 1, ".") {
        return 35;
    }
    if not list_item_equals(ref components, 2, "b") {
        return 36;
    }
    if not list_item_equals(ref components, 3, "..") {
        return 37;
    }
    return 0;
}

fn num_tests() -> i32 {
    match num::parse_i32("2147483647") {
        Ok(value) => {
            if value != 2147483647 {
                return 1;
            }
        },
        Err(_) => {
            return 2;
        },
    }
    match num::parse_i32("-2147483648") {
        Ok(value) => {
            if value != (-2147483647 - 1) {
                return 3;
            }
        },
        Err(_) => {
            return 4;
        },
    }
    match num::parse_i32("+42") {
        Ok(value) => {
            if value != 42 {
                return 5;
            }
        },
        Err(_) => {
            return 6;
        },
    }
    match num::parse_i32("2147483648") {
        Err(num::ParseOverflow(index)) => {
            if index != 9 {
                return 7;
            }
        },
        _ => {
            return 9;
        },
    }
    match num::parse_i32("-2147483649") {
        Err(num::ParseOverflow(index)) => {
            if index != 10 {
                return 28;
            }
        },
        _ => {
            return 29;
        },
    }
    match num::parse_i32("12x") {
        Err(error) => {
            match num::parse_error_index(error) {
                Some(index) => {
                    if index != 2 {
                        return 10;
                    }
                },
                None => {
                    return 11;
                },
            }
        },
        Ok(_) => {
            return 12;
        },
    }
    match num::parse_i32("") {
        Err(num::ParseEmpty) => {
        },
        _ => {
            return 14;
        },
    }
    match num::parse_i32("-") {
        Err(num::ParseSignOnly) => {
        },
        _ => {
            return 16;
        },
    }

    match num::parse_i64("9223372036854775807") {
        Ok(value) => {
            if value != 9223372036854775807 {
                return 17;
            }
        },
        Err(_) => {
            return 18;
        },
    }
    match num::parse_i64("-9223372036854775808") {
        Ok(value) => {
            if value != (-9223372036854775807 - 1) {
                return 19;
            }
        },
        Err(_) => {
            return 20;
        },
    }
    match num::parse_i64("9223372036854775808") {
        Err(num::ParseOverflow(index)) => {
            if index != 18 {
                return 21;
            }
        },
        _ => {
            return 23;
        },
    }
    match num::parse_i64("-9223372036854775809") {
        Err(num::ParseOverflow(index)) => {
            if index != 19 {
                return 30;
            }
        },
        _ => {
            return 31;
        },
    }
    if num::i32_to_decimal(-2147483647 - 1) != "-2147483648" {
        return 24;
    }
    if num::i32_to_decimal(2147483647) != "2147483647" {
        return 25;
    }
    if num::i64_to_decimal(-9223372036854775807 - 1) != "-9223372036854775808" {
        return 26;
    }
    if num::i64_to_decimal(9223372036854775807) != "9223372036854775807" {
        return 27;
    }
    if num::i32_to_decimal(0) != "0" {
        return 32;
    }
    if num::i64_to_decimal(0) != "0" {
        return 33;
    }
    return 0;
}

fn main() -> i32
audit {
    intent("Exercise the first three locked Nauqtype standard-library modules.");
    mutates();
    effects();
}
{
    let text_code = text_tests();
    if text_code != 0 {
        return text_code;
    }
    let utf8_code = utf8_tests();
    if utf8_code != 0 {
        return 40 + utf8_code;
    }
    let num_code = num_tests();
    if num_code != 0 {
        return 90 + num_code;
    }
    let path_code = path_tests();
    if path_code != 0 {
        return 130 + path_code;
    }
    return 0;
}
